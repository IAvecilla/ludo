// Leap: climb as high as you can. Every platform you land on throws you up
// again, the arrows or A and D steer, and leaving the screen by one side
// brings you back by the other. Falling off the bottom starts a new climb.
//
// Higher up, platforms get narrower, more of them move from side to side and
// more crumble after one bounce. Springs throw you ten rows up.

Player :: struct {
    x: Float, y: Float,
    vx: Float, vy: Float,
    last_y: Float,
    facing: Float,
}

Kind :: enum { :plain, :moving, :crumbly, :spring }

// `n` is the number of its row, see `noise`.
Platform :: struct { n: Int, x: Float, y: Float, w: Float, kind: Kind }

// Heights are measured downwards, as on the screen, so climbing makes y
// smaller. `camera` is the height at the top of the screen, `top` the
// highest the player has been, `base` picks the platforms of this climb, and
// `broken` has the rows whose crumbly platform broke.
World :: struct {
    player: Player,
    camera: Float,
    top: Float,
    base: Int,
    time: Float,
    broken: List[Int],
}

let width = 480.0
let height = 720.0

let player_w = 20.0
let player_h = 24.0
let run_speed = 320.0
let run_accel = 2000.0      // full speed in a sixth of a second
let gravity = 1600.0
let bounce = 920.0          // each bounce goes about 260 pixels up
let spring = 1500.0         // and from a spring, about 700, ten rows

let row = 72.0              // the height between two rows of platforms
let floor_y = 680.0         // the floor is row 0, and row k is k rows above it
let rows = 100000           // the rows of one climb
let platform_w = 64.0       // and 16 less, high enough
let platform_h = 12.0
let sweep_speed = 70.0      // how fast a moving platform starts going

config :: () -> Config {
    Config { width: to_int(width), height: to_int(height), title: "Leap" }
}

init :: () -> World {
    climb(0)
}

climb :: (base: Int) -> World {
    let y = floor_y - player_h
    World {
        player: Player { x: width / 2.0 - player_w / 2.0, y: y, vx: 0.0, vy: 0.0, last_y: y, facing: 1.0 },
        camera: 0.0,
        top: y,
        base: base,
        time: 0.0,
        broken: [],
    }
}

// The platforms are not kept in the world. Row k of a climb always has the
// same one, made up from the number of the row, so only the rows on the
// screen are built, every frame. Each climb uses other numbers: the row k of
// the climb with base b is number b + k.

noise :: (n: Int) -> Int {
    let a = (n * 1103515245 + 12345) % 2147483648
    let b = ((a / 32768) * (a % 32768) + n) % 2147483648
    let c = (b * 1103515245 + 12345) % 2147483648
    c / 65536
}

// Every third row has a platform, so the next one is always within reach,
// and the rows between have one less often the higher they are.
has_platform :: (n: Int) -> Bool {
    let k = n % rows
    k % 3 == 0 or noise(n) % 100 < 90 - min(k / 4, 55)
}

// The kind of a platform is made up from its number too. The rows that
// always have one never crumble, so the way up is never cut.
kind_of :: (n: Int) -> Kind {
    let k = n % rows
    let roll = noise(n + 13) % 100
    let moving = min(k / 8, 30)
    let crumbly = if k % 3 == 0 { 0 } else { min(k / 10, 25) }
    if k < 12 {
        :plain
    } else if roll < 4 {
        :spring
    } else if roll < 4 + moving {
        :moving
    } else if roll < 4 + moving + crumbly {
        :crumbly
    } else {
        :plain
    }
}

platform :: (n: Int, time: Float) -> Platform {
    let k = n % rows
    if k == 0 {
        Platform { n: n, x: 0.0, y: floor_y, w: width, kind: :plain }
    } else {
        let w = platform_w - to_float(min(k / 25, 16))
        let x = to_float(noise(n + 7) % to_int(width - w))
        let kind = kind_of(n)
        let x = if kind == :moving { sweep(x, w, time, k) } else { x }
        Platform { n: n, x: x, y: floor_y - to_float(k) * row, w: w, kind: kind }
    }
}

// A moving platform goes from side to side and back, starting from where it
// would stand, and faster the higher it is.
sweep :: (x: Float, w: Float, time: Float, k: Int) -> Float {
    let span = width - w
    let speed = sweep_speed + to_float(min(k, 400)) / 4.0
    let along = (x + time * speed) % (2.0 * span)
    if along < span { along } else { 2.0 * span - along }
}

on_screen :: (w: World) -> List[Platform] {
    let lowest = clamp(to_int((floor_y - w.camera - height) / row), 0, rows - 1)
    let highest = clamp(to_int((floor_y - w.camera) / row) + 1, 0, rows - 1)
    range(w.base + lowest, w.base + highest + 1)
        |> filter((n: Int) -> Bool { has_platform(n) and !(w.broken |> contains(n)) })
        |> map((n: Int) -> Platform { platform(n, w.time) })
}

update :: (w: World, input: Input, dt: Float) -> World {
    let p = w.player
        |> steer(input, dt)
        |> fly(dt)
        |> wrap()
    let w = case on_screen(w) |> find((pl: Platform) -> Bool { lands(p, pl) }) {
        Some(pl) -> bounce_on(World { w | player: p }, pl)
        None -> World { w | player: p }
    }
    let p = w.player
    let w = World { w |
        camera: min(w.camera, p.y - height * 0.45),
        top: min(w.top, p.y),
        time: w.time + dt,
    }
    if p.y > w.camera + height { climb(next_base(w)) } else { w }
}

steer :: (p: Player, input: Input, dt: Float) -> Player {
    let dir = axis(input.left or input.a, input.right or input.d)
    let step = run_accel * dt
    let vx = p.vx + clamp(dir * run_speed - p.vx, -step, step)
    let facing = if dir == 0.0 { p.facing } else { dir }
    Player { p | vx: vx, facing: facing }
}

axis :: (negative: Bool, positive: Bool) -> Float {
    if negative and !positive {
        -1.0
    } else if positive and !negative {
        1.0
    } else {
        0.0
    }
}

fly :: (p: Player, dt: Float) -> Player {
    let vy = p.vy + gravity * dt
    Player { p | x: p.x + p.vx * dt, y: p.y + vy * dt, vy: vy, last_y: p.y }
}

wrap :: (p: Player) -> Player {
    let center = p.x + player_w / 2.0
    if center < 0.0 {
        Player { p | x: p.x + width }
    } else if center > width {
        Player { p | x: p.x - width }
    } else {
        p
    }
}

// Platforms only stop the player from above: going up, it passes through.
lands :: (p: Player, pl: Platform) -> Bool {
    let falling = p.vy > 0.0
    let crossed = p.last_y + player_h <= pl.y and p.y + player_h >= pl.y
    let above = p.x + player_w > pl.x and p.x < pl.x + pl.w
    falling and crossed and above
}

// A crumbly platform breaks after the bounce, so it is not there to fall
// back on.
bounce_on :: (w: World, pl: Platform) -> World {
    let speed = if pl.kind == :spring { spring } else { bounce }
    let player = Player { w.player | y: pl.y - player_h, vy: -speed }
    let broken = if pl.kind == :crumbly { concat(w.broken, [pl.n]) } else { w.broken }
    World { w | player: player, broken: broken }
}

score :: (w: World) -> Int {
    to_int((floor_y - player_h - w.top) / 10.0)
}

// Where the next climb starts depends on how long this one lasted.
next_base :: (w: World) -> Int {
    (w.base / rows + to_int(w.time * 60.0) % 997 + 1) % 1000 * rows
}

// Drawing a platform needs the camera, which the closure given to `map`
// keeps. The shapes of each platform are a list, and `fold` joins them.
draw :: (w: World) -> List[Shape] {
    let platforms = on_screen(w)
        |> map((p: Platform) -> List[Shape] { paint(p, w.camera) })
        |> fold(sky(), concat)
    concat(platforms, concat(hero(w.player, w.camera), hud(w)))
}

sky :: () -> List[Shape] {
    [Rect { x: 0.0, y: 0.0, w: width, h: height, color: rgb(22, 24, 44) }]
}

// Each kind has the same body and its own top: green, blue for one that
// moves, orange and cracked in two for one that crumbles, and green with a
// yellow spring on it.
paint :: (pl: Platform, camera: Float) -> List[Shape] {
    let y = pl.y - camera
    case pl.kind {
        :plain -> slab(pl.x, y, pl.w, rgb(120, 200, 140))
        :moving -> slab(pl.x, y, pl.w, rgb(110, 170, 250))
        :crumbly -> {
            let half = pl.w / 2.0 - 2.0
            concat(slab(pl.x, y, half, rgb(230, 150, 80)), slab(pl.x + half + 4.0, y, half, rgb(230, 150, 80)))
        }
        :spring -> concat(slab(pl.x, y, pl.w, rgb(120, 200, 140)), coil(pl.x + pl.w / 2.0, y))
    }
}

slab :: (x: Float, y: Float, w: Float, top: Color) -> List[Shape] {
    [
        Rect { x: x, y: y, w: w, h: platform_h, color: rgb(64, 70, 110) },
        Rect { x: x, y: y, w: w, h: 4.0, color: top },
    ]
}

coil :: (x: Float, y: Float) -> List[Shape] {
    [
        Rect { x: x - 7.0, y: y - 10.0, w: 14.0, h: 10.0, color: rgb(250, 220, 90) },
        Line { x1: x - 7.0, y1: y - 6.0, x2: x + 7.0, y2: y - 6.0, thickness: 2.0, color: rgb(150, 120, 40) },
        Line { x1: x - 7.0, y1: y - 2.0, x2: x + 7.0, y2: y - 2.0, thickness: 2.0, color: rgb(150, 120, 40) },
    ]
}

// Near a side, the player shows on both, as it goes through.
hero :: (p: Player, camera: Float) -> List[Shape] {
    let y = p.y - camera
    let other = if p.x < 0.0 {
        body(p.x + width, y, p.facing)
    } else if p.x + player_w > width {
        body(p.x - width, y, p.facing)
    } else {
        []
    }
    concat(body(p.x, y, p.facing), other)
}

body :: (x: Float, y: Float, facing: Float) -> List[Shape] {
    let eye = if facing > 0.0 { 12.0 } else { 4.0 }
    [
        Rect { x: x, y: y, w: player_w, h: player_h, color: rgb(250, 196, 72) },
        Rect { x: x + eye, y: y + 7.0, w: 4.0, h: 5.0, color: rgb(30, 30, 50) },
    ]
}

hud :: (w: World) -> List[Shape] {
    let shown = [Text { x: 16.0, y: 36.0, size: 28.0, text: to_string(score(w)), color: :white }]
    if w.time < 5.0 and w.base == 0 {
        concat(shown, [Text { x: 16.0, y: 68.0, size: 20.0, text: "arrows to steer", color: rgb(170, 176, 210) }])
    } else {
        shown
    }
}
