// Leap: climb as high as you can. Every platform you land on throws you up
// again, the arrows or A and D steer, and leaving the screen by one side
// brings you back by the other. Falling off the bottom starts a new climb.

Player :: struct {
    x: Float, y: Float,
    vx: Float, vy: Float,
    last_y: Float,
    facing: Float,
}

Platform :: struct { x: Float, y: Float, w: Float }

// Heights are measured downwards, as on the screen, so climbing makes y
// smaller. `camera` is the height at the top of the screen, `top` the
// highest the player has been, and `base` picks the platforms of this climb.
World :: struct { player: Player, camera: Float, top: Float, base: Int, time: Float }

let width = 480.0
let height = 720.0

let player_w = 20.0
let player_h = 24.0
let run_speed = 320.0
let run_accel = 2000.0      // full speed in a sixth of a second
let gravity = 1600.0
let bounce = 920.0          // each bounce goes about 260 pixels up

let row = 72.0              // the height between two rows of platforms
let floor_y = 680.0         // the floor is row 0, and row k is k rows above it
let rows = 100000           // the rows of one climb
let platform_w = 64.0
let platform_h = 12.0

config :: () -> Config {
    Config { width: to_int(width), height: to_int(height), title: "Leap" }
}

init :: () -> World {
    climb(0)
}

climb :: (base: Int) -> World {
    let y = floor_y - player_h
    World {
        player: Player { x: width / 2.0 - player_w / 2.0, y: y, vx: 0.0, vy: 0.0, last_y: y, facing: 1.0 },
        camera: 0.0,
        top: y,
        base: base,
        time: 0.0,
    }
}

// The platforms are not kept in the world. Row k of a climb always has the
// same one, made up from the number of the row, so only the rows on the
// screen are built, every frame. Each climb uses other numbers: the row k of
// the climb with base b is number b + k.

noise :: (n: Int) -> Int {
    let a = (n * 1103515245 + 12345) % 2147483648
    let b = ((a / 32768) * (a % 32768) + n) % 2147483648
    let c = (b * 1103515245 + 12345) % 2147483648
    c / 65536
}

// Every third row has a platform, so the next one is always within reach,
// and the rows between have one less often the higher they are.
has_platform :: (n: Int) -> Bool {
    let k = n % rows
    k % 3 == 0 or noise(n) % 100 < 90 - min(k / 4, 55)
}

platform :: (n: Int) -> Platform {
    let k = n % rows
    if k == 0 {
        Platform { x: 0.0, y: floor_y, w: width }
    } else {
        let x = noise(n + 7) % to_int(width - platform_w)
        Platform { x: to_float(x), y: floor_y - to_float(k) * row, w: platform_w }
    }
}

on_screen :: (w: World) -> List[Platform] {
    let lowest = clamp(to_int((floor_y - w.camera - height) / row), 0, rows - 1)
    let highest = clamp(to_int((floor_y - w.camera) / row) + 1, 0, rows - 1)
    range(w.base + lowest, w.base + highest + 1) |> fold([], add_row)
}

add_row :: (platforms: List[Platform], n: Int) -> List[Platform] {
    if has_platform(n) { concat(platforms, [platform(n)]) } else { platforms }
}

update :: (w: World, input: Input, dt: Float) -> World {
    let p = w.player
        |> steer(input, dt)
        |> fly(dt)
        |> wrap()
    let p = on_screen(w) |> fold(p, land)
    let w = World { w |
        player: p,
        camera: min(w.camera, p.y - height * 0.45),
        top: min(w.top, p.y),
        time: w.time + dt,
    }
    if p.y > w.camera + height { climb(next_base(w)) } else { w }
}

steer :: (p: Player, input: Input, dt: Float) -> Player {
    let dir = axis(input.left or input.a, input.right or input.d)
    let step = run_accel * dt
    let vx = p.vx + clamp(dir * run_speed - p.vx, -step, step)
    let facing = if dir == 0.0 { p.facing } else { dir }
    Player { p | vx: vx, facing: facing }
}

axis :: (negative: Bool, positive: Bool) -> Float {
    if negative and !positive {
        -1.0
    } else if positive and !negative {
        1.0
    } else {
        0.0
    }
}

fly :: (p: Player, dt: Float) -> Player {
    let vy = p.vy + gravity * dt
    Player { p | x: p.x + p.vx * dt, y: p.y + vy * dt, vy: vy, last_y: p.y }
}

wrap :: (p: Player) -> Player {
    let center = p.x + player_w / 2.0
    if center < 0.0 {
        Player { p | x: p.x + width }
    } else if center > width {
        Player { p | x: p.x - width }
    } else {
        p
    }
}

// Platforms only stop the player from above: going up, it passes through.
land :: (p: Player, platform: Platform) -> Player {
    let falling = p.vy > 0.0
    let crossed = p.last_y + player_h <= platform.y and p.y + player_h >= platform.y
    let above = p.x + player_w > platform.x and p.x < platform.x + platform.w
    if falling and crossed and above {
        Player { p | y: platform.y - player_h, vy: -bounce }
    } else {
        p
    }
}

score :: (w: World) -> Int {
    to_int((floor_y - player_h - w.top) / 10.0)
}

// Where the next climb starts depends on how long this one lasted.
next_base :: (w: World) -> Int {
    (w.base / rows + to_int(w.time * 60.0) % 997 + 1) % 1000 * rows
}

// Drawing a platform needs the camera, and a function passed to fold sees
// only its arguments, so the camera goes along with the shapes.
Canvas :: struct { camera: Float, shapes: List[Shape] }

draw :: (w: World) -> List[Shape] {
    let canvas = on_screen(w) |> fold(Canvas { camera: w.camera, shapes: sky() }, paint)
    concat(canvas.shapes, concat(hero(w.player, w.camera), hud(w)))
}

sky :: () -> List[Shape] {
    [Rect { x: 0.0, y: 0.0, w: width, h: height, color: rgb(22, 24, 44) }]
}

paint :: (c: Canvas, platform: Platform) -> Canvas {
    let y = platform.y - c.camera
    Canvas { c | shapes: concat(c.shapes, [
        Rect { x: platform.x, y: y, w: platform.w, h: platform_h, color: rgb(64, 70, 110) },
        Rect { x: platform.x, y: y, w: platform.w, h: 4.0, color: rgb(120, 200, 140) },
    ]) }
}

// Near a side, the player shows on both, as it goes through.
hero :: (p: Player, camera: Float) -> List[Shape] {
    let y = p.y - camera
    let other = if p.x < 0.0 {
        body(p.x + width, y, p.facing)
    } else if p.x + player_w > width {
        body(p.x - width, y, p.facing)
    } else {
        []
    }
    concat(body(p.x, y, p.facing), other)
}

body :: (x: Float, y: Float, facing: Float) -> List[Shape] {
    let eye = if facing > 0.0 { 12.0 } else { 4.0 }
    [
        Rect { x: x, y: y, w: player_w, h: player_h, color: rgb(250, 196, 72) },
        Rect { x: x + eye, y: y + 7.0, w: 4.0, h: 5.0, color: rgb(30, 30, 50) },
    ]
}

hud :: (w: World) -> List[Shape] {
    let shown = [Text { x: 16.0, y: 36.0, size: 28.0, text: to_string(score(w)), color: :white }]
    if w.time < 5.0 and w.base == 0 {
        concat(shown, [Text { x: 16.0, y: 68.0, size: 20.0, text: "arrows to steer", color: rgb(170, 176, 210) }])
    } else {
        shown
    }
}
